{
  "name": "language-lesson-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A small writing journey that generates lessons for learners to copy by hand.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "app:bootstrap": "node src/db/bootstrap-demo.js"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.15",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
